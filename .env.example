# ── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Pagar.me (pagamentos + split de marketplace) ────────────
# Chaves do dashboard Pagar.me. Use as chaves de SANDBOX em dev.
PAGARME_SECRET_KEY=
NEXT_PUBLIC_PAGARME_PUBLIC_KEY=
PAGARME_WEBHOOK_SECRET=

# Recebedor (recipient) da conta principal do marketplace — recebe a
# comissão da plataforma no split. Opcional: se vazio, o restante do split
# é direcionado ao recebedor padrão da conta Pagar.me.
PAGARME_MARKETPLACE_RECIPIENT_ID=
