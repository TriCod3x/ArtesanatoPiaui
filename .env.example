NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Mercado Pago — credenciais da APLICAÇÃO (não do vendedor). Cada loja conecta
# a própria conta via OAuth (fluxo em /minha-loja/pagamentos); os tokens de
# cada vendedor ficam em stores.mp_access_token / mp_refresh_token.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# Mesmo valor de MERCADOPAGO_PUBLIC_KEY, mas exposto ao navegador — o SDK JS
# do Checkout Pro roda no cliente. Next só inlina env vars NEXT_PUBLIC_* no
# bundle (mesma solução já usada na integração Pagar.me).
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=
MERCADOPAGO_CLIENT_ID=
MERCADOPAGO_CLIENT_SECRET=
# Secret de assinatura configurado no painel do Mercado Pago (Sua aplicação >
# Webhooks > Assinatura secreta). Não confundir com CLIENT_SECRET — é usado só
# pra validar o header x-signature dos webhooks (HMAC-SHA256). OBRIGATÓRIA:
# sem ela a rota /api/webhooks/mercadopago recusa toda notificação, e nenhum
# pagamento é confirmado automaticamente. Precisa existir em todos os ambientes
# (local e Vercel: Production, Preview e Development).
MERCADOPAGO_WEBHOOK_SECRET=

# Melhor Envio — credenciais da APLICAÇÃO (não do vendedor). Cada loja conecta
# a própria conta via OAuth (fluxo em /minha-loja/frete); os tokens de cada
# vendedor ficam em stores.melhorenvio_access_token / melhorenvio_refresh_token.
# MELHORENVIO_API_URL aponta pro sandbox (https://sandbox.melhorenvio.com.br)
# por enquanto — também é a base da autorização OAuth (/oauth/authorize,
# /oauth/token vivem sob o mesmo host da API, não um subdomínio separado).
MELHORENVIO_CLIENT_ID=
MELHORENVIO_CLIENT_SECRET=
MELHORENVIO_API_URL=https://sandbox.melhorenvio.com.br
# Token de assinatura configurado em Integrações > Área Dev. > seu app >
# Webhooks, no painel do Melhor Envio — valida o header X-ME-Signature
# (HMAC-SHA256 do corpo bruto da requisição). Não estava na lista original de
# variáveis; necessário pra validar que a notificação é genuína.
MELHORENVIO_WEBHOOK_SECRET=

# Uber Direct — entrega expressa local (loja a até 30km do endereço de entrega,
# ver EXPRESS_DELIVERY_MAX_KM). Usada na cotação do checkout, na criação da
# entrega após o pagamento e na rota de teste manual /api/dev/uber-direct-quote.
UBER_DIRECT_CUSTOMER_ID=
UBER_DIRECT_CLIENT_ID=
UBER_DIRECT_CLIENT_SECRET=

# Chave de assinatura do webhook da Uber Direct. NÃO é o UBER_DIRECT_CLIENT_SECRET
# e não é gerada automaticamente em lugar nenhum: é a "Chave de autenticação"
# (Signing Key, formato UUID) que a Uber mostra SÓ na tela de edição do endpoint
# — painel Uber Direct > Desenvolvedor > Webhooks > editar o endpoint. Cada
# endpoint tem a sua. Valida o header x-uber-signature (ou x-postmates-signature,
# nome antigo): HMAC-SHA256 do corpo bruto da requisição, comparado em hex.
# Sem ela, /api/webhooks/uberdirect recusa toda notificação (fail-closed).
UBER_DIRECT_WEBHOOK_SECRET=
